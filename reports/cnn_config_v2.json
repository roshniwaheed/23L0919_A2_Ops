{
  "model": "VisionGuard_Scratch_CNN_v2",
  "seed": 42,
  "image_size": [
    224,
    224
  ],
  "epochs_max": 20,
  "learning_rate": 0.0003,
  "optimizer": "Adam",
  "loss": "binary_crossentropy",
  "dropout": 0.3,
  "conv_filters": [
    32,
    64,
    128,
    256
  ],
  "dense_units": 128,
  "checkpoint_monitor": "val_loss",
  "early_stopping_patience": 5,
  "reduce_lr_patience": 2,
  "reduce_lr_factor": 0.5
}